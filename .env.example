APP_NAME=LicenseManager
APP_ENV=production
APP_DEBUG=false
APP_URL=https://licenses.example.com
APP_FORCE_HTTPS=true
APP_KEY=change-me-to-a-random-64-char-string
APP_TIMEZONE=UTC
APP_LOCALE=pl_PL

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=licensemanager
DB_USERNAME=licensemanager
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

SESSION_NAME=licensemanager_session
CSRF_TOKEN_NAME=_token
UPLOAD_MAX_BYTES=52428800
UPLOAD_STORAGE_PATH=
DOWNLOAD_TOKEN_TTL_MINUTES=15
DOWNLOAD_TOKEN_SINGLE_USE=true
ALLOW_LOCALHOST=true
ALLOW_PRIVATE_TLDS=true
ALLOW_STAGING_KEYWORDS=staging,stage,dev,test,local
GRACE_PERIOD_DAYS=10
API_RATE_LIMIT=120
API_RATE_WINDOW=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
CRON_SECRET=change-me-cron-secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Super Admin
MAIL_FROM_ADDRESS=licenses@example.com
MAIL_FROM_NAME=LicenseManager
